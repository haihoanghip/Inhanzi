# 1. App
APP_NAME="HSK Learning"
APP_URL=http://yourdomain.com/lnhanzi/
APP_ENV=production

# 2. Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dblnhanzi
DB_USER=root
DB_PASS= 

# 3. JWT  (tạo bằng: php -r "echo bin2hex(random_bytes(64));")
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# 4. Google OAuth  (lấy từ Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://yourdomain.com/lnhanzi/api/auth/google/callback

# 5. CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com
